{
  "mcpServers": {
    "tandem": {
      "command": "node",
      "args": ["${CLAUDE_PLUGIN_ROOT}/server/mcp.js"],
      "env": {
        "TANDEM_PROJECT_DIR": "${CLAUDE_PROJECT_DIR}",
        "TANDEM_CODEX_MAX_MODEL": "${user_config.codex_max_model}",
        "TANDEM_CODEX_MAX_EFFORT": "${user_config.codex_max_effort}",
        "TANDEM_CLAUDE_MAX_MODEL": "${user_config.claude_max_model}",
        "TANDEM_MAX_PARALLEL": "${user_config.max_parallel}",
        "TANDEM_LEAN_CODEX": "${user_config.lean_codex}"
      }
    }
  }
}
